# Copy to .env (git-ignored). Docker Compose reads this file automatically.

# --- Database -------------------------------------------------------------
POSTGRES_USER=cie
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cie

# --- Claude (every assessment is evaluated by Claude) ----------------------
# The Claude bridge is a small Node server that wraps `claude -p` and runs on the HOST
# (`npm run bridge`); the container reaches it at host.docker.internal.
# Treat the token like an API key: never commit it.
# Generate one with: node -e "console.log('cie_'+require('crypto').randomBytes(24).toString('hex'))"
CLAUDE_BRIDGE_URL=http://host.docker.internal:8787
CLAUDE_BRIDGE_TOKEN=
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=180000

# --- Optional tuning ------------------------------------------------------
# Override the scoring rubric weights (JSON, must sum to 100). See docs/AI_ASSESSMENT_ENGINE.md
# SCORING_WEIGHTS={"methodologicalQuality":15,"directRelevance":15,"concentrationSimilarity":12,"endpointMatch":15,"durationMatch":10,"populationSimilarity":8,"finishedProductTesting":15,"consistency":10}
MAX_UPLOAD_MB=10
